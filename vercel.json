{
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(.*)\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "schedefacili.com" }],
      "destination": "https://www.schedefacili.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "schedefacili.vercel.app" }],
      "destination": "https://www.schedefacili.com/:path*",
      "permanent": true
    }
  ]
}
