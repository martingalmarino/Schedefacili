---
import AttivaDsa from '../../components/schede/AttivaDsa.astro';
import TestoClasse from '../../components/schede/TestoClasse.astro';
import VersioneDsa from '../../components/schede/VersioneDsa';
import TastoStampa from '../../components/calendario/TastoStampa.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import InBreve from '../../components/InBreve.astro';
import { dataAggiornamentoIso, testoAggiornato } from '../../lib/aggiornamento';
import { learningResource, urlAssoluto, webPage } from '../../lib/schema';
import { buildSeo } from '../../lib/seo';
import {
  descrizioneTabellina,
  eserciziTabellina,
  h1Tabellina,
  nomeTabellina,
  NUMERI_TABELLINE,
  percorsoTabellina,
  slugTabellina,
  soluzioneDi,
  tabella,
  titoloTabellina,
} from '../../lib/tabelline';
import { inBreveTabellina, testoClasseTabellina } from '../../lib/testi-schede';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return NUMERI_TABELLINE.map((n) => ({ params: { slug: slugTabellina(n) }, props: { n } }));
}

interface Props {
  n: number;
}

const { n } = Astro.props;
const path = percorsoTabellina(n);
const h1 = h1Tabellina(n);
const descrizione = descrizioneTabellina(n);
const righe = tabella(n);
const foglio = eserciziTabellina(n);
const precedente = n > 1 ? n - 1 : null;
const successiva = n < 10 ? n + 1 : null;
const aggiornato = testoAggiornato();
const prima = righe[0];
const ultima = righe[9];
const domande = [
  {
    domanda: `Quanto fa ${n} × 1?`,
    risposta: `${n} × 1 = ${prima?.prodotto}. È la prima riga della tabella.`,
  },
  {
    domanda: `Quanto fa ${n} × 10?`,
    risposta: `${n} × 10 = ${ultima?.prodotto}. È l’ultima riga della tabella.`,
  },
  {
    domanda: 'La versione DSA cambia i prodotti?',
    risposta: 'No. Cambia il carattere, lo spazio tra le righe e toglie il corsivo. I numeri della tabellina restano gli stessi.',
  },
  {
    domanda: 'Gli esercizi sono sempre uguali?',
    risposta: 'Su questa pagina sì. I buchi sono fissi, così puoi ristampare lo stesso foglio.',
  },
  {
    domanda: 'Dove stampo più tabelline insieme?',
    risposta: 'Nel generatore di tabelline. Lì scegli i numeri, il tipo di buco e quante operazioni ti servono.',
  },
];
const seo = buildSeo({
  title: titoloTabellina(n),
  description: descrizione,
  path,
  h1,
  keywords: [`tabellina ${n === 1 || n === 8 ? 'dell' : 'del'} ${n}`, 'tabelline da stampare', 'esercizi tabelline'],
  image: '/og/tabelline.png',
  schema: [
    webPage({ path, name: h1, description: descrizione, dateModified: dataAggiornamentoIso() }),
    learningResource({
      nome: h1,
      descrizione,
      url: urlAssoluto(path),
      educationalLevel: 'Scuola primaria',
    }),
  ],
});
---

<Base seo={seo}>
  <div class="no-stampa">
    <Breadcrumbs
      items={[
        { nome: 'Home', href: '/' },
        { nome: 'Tabelline', href: '/tabelline/' },
        { nome: nomeTabellina(n), href: path },
      ]}
    />
  </div>
  <main id="scheda" class="scheda-tabellina mx-auto max-w-[1120px] px-6 pb-16">
    <AttivaDsa />
    <h1 class="mt-2 mb-4 font-display text-[34px] leading-tight font-semibold min-[601px]:text-[40px]">{h1}</h1>
    <div class="no-stampa">
      <InBreve aggiornato={aggiornato}>{inBreveTabellina(n)}</InBreve>
      <div class="my-4 flex max-w-xl flex-wrap items-center gap-3">
        <VersioneDsa client:load targetId="scheda" />
        <div class="min-w-[220px] flex-1">
          <TastoStampa etichetta="Stampa (PDF A4)" />
        </div>
      </div>
    </div>
    <table class="scheda-numeri w-full max-w-md border-collapse bg-white text-center text-[28px]">
      <tbody>
        {
          righe.map((riga) => (
            <tr class="border-b border-solid border-[#eee]">
              <td class="px-4 py-2">
                {n} × {riga.fattore}
              </td>
              <td class="px-4 py-2">=</td>
              <td class="px-4 py-2">{riga.prodotto}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <h2 class="mt-8 text-[28px]">Esercizi</h2>
    <ol class="scheda-numeri m-0 grid list-decimal gap-3 pl-8 text-[24px]">
      {
        foglio.map((voce) => (
          <li>
            {voce.nascosto === 'a' ? <span class="inline-block min-w-8 border-b-2 border-solid border-inchiostro">&nbsp;</span> : voce.fattoreA}
            {' × '}
            {voce.nascosto === 'b' ? <span class="inline-block min-w-8 border-b-2 border-solid border-inchiostro">&nbsp;</span> : voce.fattoreB}
            {' = '}
            {voce.nascosto === 'prodotto' ? <span class="inline-block min-w-8 border-b-2 border-solid border-inchiostro">&nbsp;</span> : voce.prodotto}
          </li>
        ))
      }
    </ol>
    <details class="no-stampa mt-6">
      <summary class="cursor-pointer font-bold">Soluzioni</summary>
      <ol class="scheda-numeri mt-3 grid list-decimal gap-2 pl-6">
        {
          foglio.map((voce) => (
            <li>
              {voce.fattoreA} × {voce.fattoreB} = {voce.prodotto}. <span class="testo">Manca</span> {soluzioneDi(voce)}.
            </li>
          ))
        }
      </ol>
    </details>
    <section class="soluzioni solo-stampa">
      <h2 class="text-[28px]">Soluzioni</h2>
      <ol class="scheda-numeri grid list-decimal gap-2 pl-8 text-[22px]">
        {
          foglio.map((voce) => (
            <li>
              {voce.fattoreA} × {voce.fattoreB} = {voce.prodotto}
            </li>
          ))
        }
      </ol>
    </section>
    <nav class="no-stampa mt-8 flex flex-wrap gap-4 font-bold" aria-label="Altre schede">
      {precedente && <a href={percorsoTabellina(precedente)} class="hover:text-terracotta">{nomeTabellina(precedente)}</a>}
      {successiva && <a href={percorsoTabellina(successiva)} class="hover:text-terracotta">{nomeTabellina(successiva)}</a>}
      <a href="/tabelline/tavola-pitagorica/" class="hover:text-terracotta">Tavola pitagorica</a>
      <a href="/generatori/tabelline/" class="hover:text-terracotta">Generatore di tabelline</a>
    </nav>
    <TestoClasse testo={testoClasseTabellina(n)}>
      <h2 class="mt-10 text-[28px]">Domande</h2>
      <Faq domande={domande} path={path} />
    </TestoClasse>
  </main>
</Base>
