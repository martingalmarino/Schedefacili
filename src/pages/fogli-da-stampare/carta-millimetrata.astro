---
import SchedaFoglio from '../../components/fogli/SchedaFoglio.astro';
import { opzioniDaQuery } from '../../lib/fogli';
import { COLLEGAMENTI_MATEMATICA, FAQ_MM, IN_BREVE_MM, PAGINE_FOGLI } from '../../lib/testi-fogli';

const pagina = PAGINE_FOGLI[2];
const path = pagina.href;
---

<SchedaFoglio
  path={path}
  title={pagina.title}
  description={pagina.description}
  h1={pagina.h1}
  keywords={['carta millimetrata a4 da stampare', 'carta millimetrata pdf', 'carta millimetrata da stampare']}
  inBreve={IN_BREVE_MM}
  domande={FAQ_MM}
  opzioni={opzioniDaQuery('millimetrata', Astro.url.searchParams)}
  nomeBreadcrumb="Carta millimetrata"
  educationalLevel="Scuola primaria"
  collegamenti={[
    { href: '/fogli-da-stampare/', etichetta: 'Tutti i fogli' },
    { href: '/fogli-da-stampare/quadretti-1-cm/', etichetta: 'Quadretti 1 cm' },
    { href: '/fogli-da-stampare/quadretti-0-5-cm/', etichetta: 'Quadretti 0,5 cm' },
    ...COLLEGAMENTI_MATEMATICA,
  ]}
/>
