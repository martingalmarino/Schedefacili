---
import { EMAIL } from '../config/site';
import { dataInItaliano } from '../lib/ricorrenze';
import { webPage } from '../lib/schema';
import { buildSeo } from '../lib/seo';
import PaginaLegale from '../layouts/PaginaLegale.astro';

const path = '/contatti/';
const h1 = 'Contatti';
const description = 'Per scrivere a Schede Facili si usa un indirizzo email. Non c’è un modulo di contatto.';
const aggiornato = dataInItaliano(new Date());
const seo = buildSeo({
  title: 'Contatti – Schede Facili',
  description,
  path,
  h1,
  keywords: ['contatti schede facili'],
  schema: [webPage({ path, name: h1, description, dateModified: new Date().toISOString() })],
});
---

<PaginaLegale seo={seo} aggiornato={aggiornato}>
  <p slot="breve">Le richieste si inviano all’indirizzo email del sito. Non è previsto un modulo.</p>
  <p class="font-display text-[28px] font-semibold">{EMAIL}</p>
  <p>La risposta arriva allo stesso indirizzo. Non si chiedono dati oltre a quelli del messaggio.</p>
</PaginaLegale>
