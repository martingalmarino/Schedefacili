---
import { breadcrumb, jsonLd, type VoceBreadcrumb } from '../lib/schema';

interface Props {
  items: VoceBreadcrumb[];
}

const { items } = Astro.props;
---

<div class="mx-auto max-w-[1120px] px-6">
  <nav class="pt-[18px] pb-1 text-[14px] break-words text-muted" aria-label="Percorso">
    {
      items.map((item, indice) => {
        const ultimo = indice === items.length - 1;
        return (
          <>
            {indice > 0 && (
              <span aria-hidden="true"> › </span>
            )}
            {ultimo ? (
              <span aria-current="page">{item.nome}</span>
            ) : (
              <a href={item.href} class="hover:text-terracotta">
                {item.nome}
              </a>
            )}
          </>
        );
      })
    }
  </nav>
</div>
<script type="application/ld+json" set:html={jsonLd(breadcrumb(items))} />
