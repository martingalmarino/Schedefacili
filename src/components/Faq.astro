---
import { marcaAnni } from '../lib/cifre';
import { faqPage, jsonLd, type VoceFaq } from '../lib/schema';

interface Props {
  domande: VoceFaq[];
  path?: string;
}

const { domande, path } = Astro.props;
---

<section>
  {
    domande.map((voce) => (
      <>
        <h3 class="mt-4 mb-1 text-[19px]">{voce.domanda}</h3>
        <p class="m-0" set:html={marcaAnni(voce.risposta)} />
      </>
    ))
  }
</section>
<script type="application/ld+json" set:html={jsonLd(faqPage(domande, path))} />
