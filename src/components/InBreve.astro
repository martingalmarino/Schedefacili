---
import { marcaAnni } from '../lib/cifre';

interface Fonte {
  etichetta: string;
  href: string;
}

interface Props {
  fonte?: Fonte;
  aggiornato?: string;
}

const { fonte, aggiornato } = Astro.props;
const mostraMeta = Boolean(fonte || aggiornato);
---

<div class="in-breve max-w-[820px] rounded-lg border-l-[5px] border-solid border-salvia bg-white px-[22px] py-[18px]">
  <b>In breve.</b>{' '}
  <slot />
  {
    mostraMeta && (
      <i class="mt-2 block">
        {fonte && (
          <>
            Fonte: <a href={fonte.href} set:html={marcaAnni(fonte.etichetta)} />
          </>
        )}
        {fonte && aggiornato && ' · '}
        {aggiornato && <span set:html={`Aggiornato il ${marcaAnni(aggiornato)}`} />}
      </i>
    )
  }
</div>
